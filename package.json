{
  "name": "@aoxborrow/registrar-client",
  "version": "0.3.0",
  "description": "One consistent, fully-typed TypeScript interface to many domain registrar APIs (GoDaddy, Cloudflare, Namecheap, Spaceship, Dynadot, Porkbun, and more) behind a single pluggable multi-provider client",
  "author": {
    "name": "Aaron Oxborrow",
    "url": "https://github.com/aoxborrow"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/aoxborrow/registrar-client",
  "funding": "https://github.com/sponsors/aoxborrow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoxborrow/registrar-client.git"
  },
  "bugs": {
    "url": "https://github.com/aoxborrow/registrar-client/issues"
  },
  "keywords": [
    "registrar",
    "registrar-api",
    "domains",
    "domain-registration",
    "domain-management",
    "dns",
    "epp",
    "whois",
    "rdap",
    "typescript",
    "cloudflare",
    "godaddy",
    "namecheap",
    "gandi",
    "porkbun",
    "dynadot",
    "namesilo",
    "spaceship",
    "namebright"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "npm run tsc && npm run eslint && npm run prettier",
    "lint:fix": "npm run eslint:fix && npm run prettier:fix",
    "eslint": "eslint --cache --cache-location .eslintcache .",
    "eslint:fix": "eslint --cache --cache-location .eslintcache . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write --list-different .",
    "ts": "npm run lint",
    "ts:fix": "npm run lint:fix",
    "tsc": "tsc --noEmit",
    "typecheck": "npm run tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "clear:ts": "rm -rf tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "clear:eslint": "rm -rf .eslintcache",
    "clear": "npm run clear:ts && npm run clear:eslint && rm -rf dist coverage",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push --follow-tags && gh release create v$(node -p \"require('./package.json').version\") --generate-notes",
    "release:minor": "npm version minor && git push --follow-tags && gh release create v$(node -p \"require('./package.json').version\") --generate-notes",
    "release:major": "npm version major && git push --follow-tags && gh release create v$(node -p \"require('./package.json').version\") --generate-notes"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0"
  }
}
