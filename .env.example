# Registrar configuration — every provider's config options.
#
# Copy to .env and fill in only the registrars you use. Values are read by the
# integration tests (npm run test:integration) for the sandbox-capable providers
# below; the others are listed so this file is a complete reference for the
# credentials each provider's constructor expects.
#
# Env var naming: <PROVIDER>_<FIELD>, where FIELD is the provider's config field
# upper-snake-cased (apiKey -> API_KEY, apiSecret -> API_SECRET, etc.).
# Missing credentials cause that registrar's integration suite to skip.

# ============================================================================
# Sandbox-capable providers (exercised by the integration suite)
# For these, <PROVIDER>_ENVIRONMENT selects "sandbox" (default) or "production".
# ============================================================================

# GoDaddy — key + secret. Use OTE (test) keys for sandbox.
# Get keys: https://developer.godaddy.com  (Account Settings > API Keys)
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_ENVIRONMENT=sandbox

# Namecheap — sandbox account + API key from https://www.sandbox.namecheap.com
# IP allowlisting is mandatory; set the whitelisted IPv4 as CLIENT_IP (optional).
NAMECHEAP_USERNAME=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_ENVIRONMENT=sandbox

# Gandi — sandbox API key from https://api.sandbox.gandi.net (separate account)
GANDI_API_KEY=
GANDI_ENVIRONMENT=sandbox

# NameSilo — API key from your account (has a sandbox environment)
NAMESILO_API_KEY=
NAMESILO_ENVIRONMENT=sandbox

# ============================================================================
# Production-only providers (no sandbox; not run by the integration suite,
# listed for completeness — these are the fields their constructors need)
# ============================================================================

# Cloudflare — API token + Account ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Dynadot — API key (enable API access under Tools > API)
DYNADOT_API_KEY=

# Spaceship — API key + secret from the API Manager
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# Porkbun — API key + secret (enable API access per-domain)
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# NameBright — OAuth2 client ID + secret
NAMEBRIGHT_CLIENT_ID=
NAMEBRIGHT_CLIENT_SECRET=
