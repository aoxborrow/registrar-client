# Credentials for registrar SANDBOX integration tests.
# Copy to .env and fill in only the registrars you want to test.
# Missing entries cause that registrar's integration suite to skip.
#
# Run with: npm run test:integration

# GoDaddy — use OTE (test environment) keys from https://developer.godaddy.com
GODADDY_API_KEY=
GODADDY_API_SECRET=

# Namecheap — sandbox account + API key from https://www.sandbox.namecheap.com
NAMECHEAP_USERNAME=
NAMECHEAP_API_KEY=
# whitelisted IP for API access (Namecheap enforces IP allowlisting)
NAMECHEAP_CLIENT_IP=

# Gandi — sandbox API key from https://api.sandbox.gandi.net (separate account)
GANDI_API_KEY=
