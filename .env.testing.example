# Sandbox credentials for integration tests (npm run test:integration).
#
# Copy to .env.testing (gitignored) and fill in only the registrars you want to
# test. The integration suite loads .env.testing — kept separate from .env so
# tests never touch production accounts. A registrar's suite skips unless its
# required credentials are present here.
#
# Only registrars with a sandbox/test environment appear below; each is pinned to
# its sandbox via <PROVIDER>_ENVIRONMENT=sandbox.

# GoDaddy — OTE (test) Key/Secret from https://developer.godaddy.com
# OTE (the sandbox) serves the legacy v1/v2 API ONLY — it has no v3 — so use the
# sso-key Key/Secret pair here. A PAT is NOT applicable to OTE (v3 has no sandbox,
# and a prod PAT belongs to a different shopper realm); leave the token empty.
GODADDY_API_TOKEN=
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_ENVIRONMENT=sandbox

# Namecheap — sandbox account + API key from https://www.sandbox.namecheap.com
# ClientIp must be a whitelisted IPv4 (a required request parameter).
NAMECHEAP_USERNAME=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_ENVIRONMENT=sandbox

# Gandi — sandbox API key from https://api.sandbox.gandi.net (separate account)
GANDI_API_KEY=
GANDI_ENVIRONMENT=sandbox

# NameSilo — OTE (sandbox) API key; sandbox host is ote.namesilo.com
NAMESILO_API_KEY=
NAMESILO_ENVIRONMENT=sandbox

# Porkbun — sandbox uses the SAME base URL as production; only the key differs.
# A sandbox key is prefixed `pk1_sb_` and runs against an isolated test
# environment: no real registry actions, no DNS changes, no charges. Each sandbox
# starts with $1,000 of fake credit and every response includes "sandbox": true.
# Out of credit / want a clean slate? POST /sandbox/topup or POST /sandbox/reset
# with a sandbox key. (Because only the key selects sandbox, PORKBUN_ENVIRONMENT
# is cosmetic here — the pk1_sb_ key is what routes to the test environment.)
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
PORKBUN_ENVIRONMENT=sandbox
